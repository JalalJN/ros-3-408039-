<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"><xacro:macro name="two_link_arm" params="">
<link name="arm_mount"><visual><geometry><cylinder radius="0.045" length="0.06"/></geometry><material name="grey"/></visual></link>
<joint name="arm_mount_joint" type="fixed"><parent link="base_link"/><child link="arm_mount"/><origin xyz="0 0 0.09"/></joint>
<link name="arm_link_1">
 <visual><origin xyz="0 0 0.14"/><geometry><box size="0.05 0.05 0.20"/></geometry><material name="orange"/></visual>
 <collision><origin xyz="0 0 0.14"/><geometry><box size="0.05 0.05 0.20"/></geometry></collision>
</link>
<joint name="shoulder_joint" type="revolute"><parent link="arm_mount"/><child link="arm_link_1"/><origin xyz="0 0 0.03"/><axis xyz="0 1 0"/><limit lower="-0.6" upper="0.6" effort="10" velocity="1"/></joint>
<link name="arm_link_2">
 <visual><origin xyz="0 0 0.11"/><geometry><box size="0.05 0.05 0.14"/></geometry><material name="blue"/></visual>
 <collision><origin xyz="0 0 0.11"/><geometry><box size="0.05 0.05 0.14"/></geometry></collision>
</link>
<joint name="elbow_joint" type="revolute"><parent link="arm_link_1"/><child link="arm_link_2"/><origin xyz="0 0 0.28"/><axis xyz="0 1 0"/><limit lower="-0.8" upper="0.8" effort="5" velocity="1"/></joint>
<link name="tool_link"><visual><geometry><sphere radius="0.018"/></geometry><material name="red"/></visual></link>
<joint name="tool_joint" type="fixed"><parent link="arm_link_2"/><child link="tool_link"/><origin xyz="0 0 0.22"/></joint>
</xacro:macro></robot>
