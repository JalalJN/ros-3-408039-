<?xml version="1.0"?>
<robot name="my_first_model">
<material name="blue"><color rgba="0.05 0.25 0.8 1"/></material>
<material name="grey"><color rgba="0.15 0.15 0.18 1"/></material>
<material name="orange"><color rgba="1 0.42 0.04 1"/></material>
<material name="red"><color rgba="0.8 0.05 0.05 1"/></material>
<material name="white"><color rgba="0.9 0.9 0.9 1"/></material>
<link name="base_footprint"/>
<link name="base_link">
 <visual><geometry><box size="0.50 0.32 0.12"/></geometry><material name="blue"/></visual>
 <collision><geometry><box size="0.50 0.32 0.12"/></geometry></collision>
</link>
<joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.16"/></joint>
<link name="caster_link"><visual><geometry><sphere radius="0.04"/></geometry><material name="grey"/></visual><collision><geometry><sphere radius="0.04"/></geometry></collision></link>
<joint name="caster_joint" type="fixed"><parent link="base_link"/><child link="caster_link"/><origin xyz="-0.20 0 -0.12"/></joint>
<link name="wheel_left">
  <visual><origin rpy="1.5707963267948966 0 0"/><geometry><cylinder radius="0.1" length="0.05"/></geometry><material name="grey"/></visual>
  <collision><origin rpy="1.5707963267948966 0 0"/><geometry><cylinder radius="0.1" length="0.05"/></geometry></collision>
</link>
<joint name="wheel_left_joint" type="continuous"><parent link="base_link"/><child link="wheel_left"/><origin xyz="0.10 0.195 -0.06"/><axis xyz="0 1 0"/></joint>
<!-- A visible radial spoke makes rotation observable in RViz. -->
<link name="spoke_left"><visual><geometry><box size="0.16 0.052 0.012"/></geometry><material name="orange"/></visual></link>
<joint name="spoke_left_joint" type="fixed"><parent link="wheel_left"/><child link="spoke_left"/></joint>
<link name="wheel_right">
  <visual><origin rpy="1.5707963267948966 0 0"/><geometry><cylinder radius="0.1" length="0.05"/></geometry><material name="grey"/></visual>
  <collision><origin rpy="1.5707963267948966 0 0"/><geometry><cylinder radius="0.1" length="0.05"/></geometry></collision>
</link>
<joint name="wheel_right_joint" type="continuous"><parent link="base_link"/><child link="wheel_right"/><origin xyz="0.10 -0.195 -0.06"/><axis xyz="0 1 0"/></joint>
<!-- A visible radial spoke makes rotation observable in RViz. -->
<link name="spoke_right"><visual><geometry><box size="0.16 0.052 0.012"/></geometry><material name="orange"/></visual></link>
<joint name="spoke_right_joint" type="fixed"><parent link="wheel_right"/><child link="spoke_right"/></joint>
</robot>
